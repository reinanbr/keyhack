<?xml version="1.0" encoding="utf-8"?>
<!--
  GIF search is the only network use. HTTPS only, and only the system's CA
  store: user-installed CAs (a common way to intercept traffic) are not trusted.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
