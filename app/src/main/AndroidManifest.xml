<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Key-press haptics. INTERNET comes from :net, for GIF search only (ADR 0004), online build only. -->
  <uses-permission android:name="android.permission.VIBRATE" />

  <!--
    Typing data never leaves the device: no cloud backup, no device-to-device
    transfer. Manual, passphrase-encrypted export arrives in M9.
  -->
  <application
    android:name=".KeyHackApp"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="false"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:supportsRtl="true"
    android:theme="@style/Theme.KeyHack"
    tools:targetApi="31">

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!--
      androidx.profileinstaller (pulled in by Compose in release builds) ships
      an exported receiver used only by benchmarking tools. It is removed to
      keep the exported set minimal (ADR 0002); baseline profiles still install
      through androidx.startup. Lint cannot see the class from this module.
    -->
    <receiver
      android:name="androidx.profileinstaller.ProfileInstallReceiver"
      tools:ignore="MissingClass"
      tools:node="remove" />
  </application>
</manifest>
