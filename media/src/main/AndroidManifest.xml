<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- The INTERNET permission and the HTTP client live in :net (online build only). -->

  <application>
    <!-- Hands a downloaded GIF to the target app through commitContent. Not exported:
         apps get access only to the one URI KeyHack grants them. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.media"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/keyhack_media_paths" />
    </provider>
  </application>
</manifest>
