<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    GIF search is the only feature that uses the network (see docs/adr/0004).
    Requests go only to the provider the user picked, over HTTPS, and only
    after they open the GIF panel. Turning GIFs off in settings stops all
    network use.
  -->
  <uses-permission android:name="android.permission.INTERNET" />

  <application>
    <!-- Hands a downloaded GIF to the target app through commitContent. Not exported:
         apps get access only to the one URI KeyHack grants them. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.media"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/keyhack_media_paths" />
    </provider>
  </application>
</manifest>
