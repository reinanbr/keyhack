<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <application>
    <!--
      The IME service is exported (the system binds it) and guarded by
      BIND_INPUT_METHOD, which only the system holds. See docs/adr/0002.
    -->
    <service
      android:name=".KeyHackImeService"
      android:exported="true"
      android:label="@string/keyhack_ime_name"
      android:permission="android.permission.BIND_INPUT_METHOD">
      <intent-filter>
        <action android:name="android.view.InputMethod" />
      </intent-filter>
      <meta-data
        android:name="android.view.im"
        android:resource="@xml/keyhack_method" />
    </service>
  </application>
</manifest>
