<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    GIF search is the only feature that uses the network (see docs/adr/0004).
    Requests go only to the provider the user picked, over HTTPS, and only
    after they open the GIF panel. Turning GIFs off in settings stops all
    network use. The offline build leaves this module out.
  -->
  <uses-permission android:name="android.permission.INTERNET" />
</manifest>
